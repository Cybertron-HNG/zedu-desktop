# Template for `.env` at the project root (same keys, safe defaults).
# Never commit real secrets; use CI secrets or --dart-define for production.

API_BASE_URL=https://api.staging.zedu.chat/api/v1/
USE_MOCK_DATA=false

# Realtime Centrifugo Websocket URL
REALTIME_URL=wss://realtime.staging.zedu.chat/connection/websocket

# Google Sign-In Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
